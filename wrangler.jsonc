{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuugen-project-web",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve static assets first; the Worker only runs for routes the
    // asset server can't satisfy (e.g. the /api/* endpoints below).
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
